# Anthropic — for Claude vision verdict
ANTHROPIC_API_KEY=sk-ant-...

# Supabase — get from https://supabase.com/dashboard/project/<ref>/settings/api
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=          # only on the Pi for server-side writes; never in the dashboard
SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Cync — not used in v1. Grow light is scheduled directly in the Cync app
# (sunrise/sunset for the home's zip code). Pi does not control the plug.
# v2 will swap to a Kasa/Shelly plug with a real local API.

# ESP32
ESP32_HOST=esp32.local               # or its LAN IP if mDNS flakes
ESP32_WATER_ENDPOINT=/water

# Jetson
JETSON_HOST=paul@jetson.local
JETSON_CAPTURE_DIR=~/wy2z_captures
